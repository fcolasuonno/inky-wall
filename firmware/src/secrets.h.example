#pragma once

// Local credentials for the build. Never commit this file (it is gitignored).
// Copy secrets.h.example to secrets.h and fill in your own values:
//
//     cp firmware/src/secrets.h.example firmware/src/secrets.h
//
// The example file is the tracked, publishable one.

// ---- WiFi -------------------------------------------------------------------
#define WIFI_SSID           "your-ssid"
#define WIFI_PASS           "your-wifi-password"

// ---- MQTT -------------------------------------------------------------------
// Broker that both Tesserae and this panel use. Set MQTT_USER to "" for an
// unauthenticated broker.
#define MQTT_HOST           "mqtt.example.lan"
#define MQTT_PORT           1883
#define MQTT_USER           "tesserae"
#define MQTT_PASS           "your-mqtt-password"
